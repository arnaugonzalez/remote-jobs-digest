# Copy to the path shown by `rjs paths` (default ~/.config/rjs/.env).
# Real environment variables always win over this file.

# --- Optional LLM pass (any OpenAI-compatible endpoint) ----------------------
# Without a key, `rjs run` still works: deterministic filters only.
# RJS_LLM_BASE_URL=https://api.groq.com/openai/v1      # default
# RJS_LLM_API_KEY=
# RJS_LLM_MODEL=llama-3.3-70b-versatile                  # default
#
# Other endpoints:
#   OpenAI      RJS_LLM_BASE_URL=https://api.openai.com/v1           RJS_LLM_MODEL=gpt-4o-mini
#   OpenRouter  RJS_LLM_BASE_URL=https://openrouter.ai/api/v1        RJS_LLM_MODEL=<vendor/model>
#   Gemini      RJS_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  RJS_LLM_MODEL=gemini-2.5-flash
#   Ollama      RJS_LLM_BASE_URL=http://localhost:11434/v1           RJS_LLM_MODEL=llama3.1   (no key)
#
# Optional fallback when the primary is rate-limited (429):
# RJS_LLM_FALLBACK_BASE_URL=
# RJS_LLM_FALLBACK_API_KEY=
# RJS_LLM_FALLBACK_MODEL=
# RJS_AI_LANGUAGE=English        # language of the one-line "reason"
# RJS_AI_MAX_JOBS=120            # max jobs sent to the LLM per run
# RJS_AI_MIN_FIT=5

# --- Optional Telegram digest ---------------------------------------------
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- Operation --------------------------------------------------------------
# RJS_DIGEST_TOP_N=12
# RJS_ATS_WORKERS=14             # parallel requests when scanning ATS boards
# RJS_OUTPUT_DIR=                # default: <data dir>/output

# --- apply extra (supervised pilot) ----------------------------------------
# RJS_CV_PATH=~/cv.pdf
# RJS_CHROME_PROFILE=~/.config/rjs-chrome-profile
# GMAIL_ADDRESS=
# GMAIL_APP_PASSWORD=
